// bgfx backend, Android platform — phase 4 of the bgfx-on-Android
// bring-up (#303). On-device sibling of `examples/bgfx` (desktop). The
// generated build compiles the game as a `lib<name>.so` for
// `aarch64-linux-android`, importing the bgfx backend's Android-capable
// gfx/input/audio/window modules plus the `android_app` NativeActivity
// glue, and links the NDK libs (android, log, EGL, GLESv3, m, dl). The C++
// runtime comes from Zig's toolchain, not the NDK's libc++_shared.so.
//
// The generated `main.zig` owns the NativeActivity `android_main` entry:
// it registers a one-shot engine-init callback (fired once bgfx is up on
// INIT_WINDOW) and a per-frame tick callback, then hands the event/frame
// loop to `android_app.run`.
//
// Build: `labelle-assembler generate --project-root .` then
// `cd .labelle/bgfx_android && zig build` (produces the .so) +
// `zig build package` (wraps it as a NativeActivity APK).
.{
    .name = "example_bgfx_android",
    .title = "LaBelle — bgfx (Android)",
    .width = 800,
    .height = 600,
    .target_fps = 60,
    .backend = .bgfx,
    // Resolve the bgfx backend from THIS repo, exactly like the two desktop
    // examples. Without it the builtin `.backend = .bgfx` provider pins a stale
    // RELEASED tag, and CI's "bgfx-android example .so cross-build" job — the
    // one job that is supposed to prove this backend works end-to-end through
    // the toolkit — fetched `backend bgfx 0.6.6 (remote)` and never compiled a
    // line of the PR under test (found while investigating #100 review round 2;
    // the workflow comment already claimed this example used `local:../..`).
    .backend_package = .{
        .name = "bgfx",
        .repo = "local:../..",
        .version = "0.22.1",
    },
    // Post-fx on the ANDROID example specifically (labelle-bgfx#122).
    //
    // bloom -> crt matches `examples/bgfx` exactly, so the two examples render
    // the same stack and a device capture is comparable to the desktop one.
    //
    // This exists because #65 — the white-screen ANR on Adreno 610 — was an
    // Android/GLES POST-FX bug, and until now no example ran post-fx on a
    // physical device: `examples/bgfx` has the stack but no `.android` block,
    // and this one had the block but no stack. CI's ReleaseFast post-fx smoke
    // runs the desktop example HEADLESS ON THE HOST, so the exact configuration
    // that produced #65 had no device coverage at all.
    //
    // It also makes CI's existing Android `libgame.so` cross-build cover
    // post-fx codegen for free.
    .post_fx = .{
        .{ .bloom = .{ .threshold = 0.75, .intensity = 1.4, .radius = 1.5 } },
        .{ .crt = .{ .curvature = 0.12, .scanline = 0.5, .mask = 0.3, .aberration = 0.004 } },
    },
    .y_axis = .up,
    .ecs = .mock,
    .initial_prefab = "main",
    .states = .{"playing"},
    .resources = .{
        .{ .name = "icons", .json = "assets/icon.json", .texture = "assets/icon.tga" },
    },
    .layers = .{
        .{ .name = "far_background", .order = 0, .space = .screen },
        .{ .name = "terrain", .order = 1, .space = .world },
        .{ .name = "characters", .order = 2, .space = .world },
        .{ .name = "effects", .order = 3, .space = .world },
        .{ .name = "hud", .order = 4, .space = .screen },
    },
    .android = .{
        .app_name = "LaBelle bgfx",
        .package_name = "com.labelle.bgfx_demo",
        .min_sdk_version = 28,
        .target_sdk_version = 34,
    },
    // The generated build overrides the backend gfx module's core with THIS one
    // (build_fragments/backend_dep.txt), so this pin is what actually decides
    // what the backend compiles against.
    //
    // A COHERENT RELEASED SET, moved together: the backend requires core's
    // game-owned `shader_material` contract (labelle-core#79, core 2.0.0) with
    // the matching gfx 2.0.0 (labelle-gfx#361) and engine 3.x
    // (labelle-engine#882). Keep the three on one line of the toolkit's
    // version floors — since labelle-assembler 0.109.0 `generate` REFUSES a
    // mixed set (this example sat on engine 2.11.0 / gfx 1.30.0 under core
    // 2.0.0, and the current CLI could not build it at all: labelle-bgfx#114).
    //
    // Note that pins are not necessarily what gets compiled: the assembler
    // prefers sibling checkouts (`../labelle-core`, …) when they exist and
    // says so ("built from LOCAL sources"). CI has no siblings and fetches
    // exactly these.
    .core_version = "2.0.0",
    .engine_version = "3.1.0",
    .gfx_version = "2.2.0",
    .labelle_version = "local:../../../labelle-cli",
    .assembler_version = "local:../../../labelle-assembler",
}
