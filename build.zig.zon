.{
    .fingerprint = 0x9cd73c2cb5d6d1eb,
    .name = .labelle_bgfx,
    .version = "0.28.1",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Pinned to specific commits — same class of fix as #146.
        // Bumping either dep requires `zig fetch <new-url>` to get
        // the new hash, then updating the url and hash together.
        // wasm/WebGL-capable zbgfx (bgfx-wasm epic labelle-bgfx#8), forked from
        // upstream `cyberegoorg/zbgfx`. The fork's `feat/wasm-emscripten` branch
        // adds a `-Demsdk_sysroot` option + `is_emscripten` build arm that
        // compiles bgfx/bx/bimg for wasm32-emscripten (forces single-threaded,
        // drops the ASTC encoder's std::thread path, aliases bx's version macros,
        // hosts shaderc). NATIVE builds are byte-for-byte unchanged — every wasm
        // change is guarded by `target.result.os.tag == .emscripten`. Submitted
        // upstream as PR cyberegoorg/zbgfx#9.
        //
        // The fork now also carries the `screen_shot` vtable fix (#61): its
        // `CCallbackVtblT` was missing bgfx's `_format` parameter, shifting every
        // later argument and segfaulting the render thread on the first
        // `--screenshot`. `src/bgfx_callback.zig` consumes `CCallbackVtblT`
        // directly, so that fix has to be IN the pinned commit — do not repin
        // back to a revision predating 934372f.
        //
        // API 161 bump (labelle-bgfx#119): this revision re-vendors bgfx from
        // API 142 to 81d81fba (2026-09-19), with bx at 663631eb and bimg at
        // 87aaad3a. It also drops `3rdparty/fcpp` and `3rdparty/glsl-optimizer`
        // (both removed upstream), gates the new native video decoder behind
        // `-Dvideo` (default off, so no VideoToolbox/CoreMedia/CoreVideo dependency), and
        // raises the x86 CPU baseline to SSE4.2 because bx's simd_t.h now
        // requires it. The screen_shot vtable fix below is still IN this commit.
        // Pinned to eb71fd4 (labelle-toolkit/zbgfx#2): the zbgfx#1 API 161 vendor
        // plus the web ASTC fix: the emscripten format table lists the full
        // LDR set, so 8x8 samples natively on WebGL (#147).
        //
        // Host note: the fork previously lived at `codeberg.org/apotema/zbgfx`
        // (commit 0b229b7). It moved to the labelle-toolkit org on GitHub so it
        // sits with the rest of the toolkit and so upstreaming is a normal PR;
        // the Codeberg copy is stale and should not be repinned.
        .zbgfx = .{
            .url = "https://github.com/labelle-toolkit/zbgfx/archive/eb71fd4b0339cbad09c755eea52091c3105ac719.tar.gz",
            .hash = "zbgfx-0.12.0-Sm4IxN_KDAf834PtToJwIjR0-zzWnYOjJWZAtPUwhAHZ",
        },
        .zglfw = .{
            .url = "https://github.com/zig-gamedev/zglfw/archive/0dd29d8073487c9fe1e45e6b729b3aac271d5a71.tar.gz",
            .hash = "zglfw-0.10.0-dev-zgVDNIG4IQBWN_sfMD-xfC9bJS2hbBN2W7jNlDLovcdC",
        },
        // Shared Android gamepad source (#310 Stage 4). In-tree sub-package
        // shared with the sokol backend: the per-device STATE machine
        // (`android_gamepad_state.zig`, #250) as the `android_gamepad` module,
        // plus the InputManager JNI DETECTION glue (`android_gamepad_jni.c`,
        // #248) reached via `dep.path(...)` and compiled into `input` on
        // Android. Off Android nothing here is referenced.
        .labelle_android_gamepad = .{
            .url = "https://github.com/labelle-toolkit/labelle-android-gamepad/archive/refs/tags/v0.1.0.tar.gz",
            .hash = "labelle_android_gamepad-0.1.0-aniuyr7OAADukHTeqRqavrEvsUDAutllmC2KJDek0Ox9",
        },
        // Shared Android platform services (labelle-bgfx#149 phase 1): the
        // launch-intent extras → env mapping, the `android:debuggable` query,
        // the stuck-window relayout (JNI C compiled INSIDE the package — it
        // owns the NDK sysroot helper), the AAudio output device (#306; the
        // package links `libaaudio`) and the MediaCodec video + audio-track
        // decoders with the shared `yuv`/`planes` helpers (FP#549; links
        // `libmediandk`). One named module, `labelle_android`, imported by
        // `gfx`, `audio` and `android_app`. Eager (not lazy): `build.zig`
        // will `@import` its build helpers in a later phase.
        // Commit pin until labelle-android v0.1.0 is tagged. NEVER a committed
        // `.path`: `.labelle/deps/labelle-bgfx` is a copy, so a relative path
        // would not resolve from an assembled game.
        .labelle_android = .{
            .url = "https://github.com/labelle-toolkit/labelle-android/archive/df5b78ec2c07360f4e87c85bfdfd59e21db8b08d.tar.gz",
            .hash = "labelle_android-0.1.0-sErgQs3nAwCwI6QRpkuN_OWgtPWxkoMJbvTzhGoaXZUr",
        },
        // Shared windowless-SDL desktop gamepad source (core#28). In-tree
        // sub-package shared with the raylib and sokol desktop backends via a
        // relative path. On desktop targets, bgfx's `input` routes the gamepad
        // getters through this SDL HIDAPI source (so Switch-mode pads read)
        // instead of GLFW. The assembler stages it under .labelle/deps/ only
        // when `.gamepad = .auto`; off Android/desktop-disabled nothing here is
        // referenced.
        .labelle_sdl_gamepad = .{
            .url = "https://github.com/labelle-toolkit/labelle-sdl-gamepad/archive/refs/tags/v0.1.0.tar.gz",
            .hash = "labelle_sdl_gamepad-0.1.0-zOpuDcSwAABZaICKS4AEVvghHnZSNDyls-wzdnYc6cLQ",
        },
        // labelle-core (#310 Stage 4 + #386 Phase 3). The bgfx Android backend
        // adapter (`src/android.zig`) imports core for the `AndroidBackendContext`
        // type it hands to `registerAndroidBackend`; `src/window.zig` and
        // `src/input.zig` additionally import it to PROVE contract conformance at
        // comptime (`core.assertWindow` / `core.assertInput`). Those asserts are
        // comptime-only (no core types cross the engine seam), so they need no
        // codegen unification. The generated build still `overrideImport`s the
        // app's unified core onto the bgfx `input` module on Android so the
        // registered vtable's type matches the engine's; this pin resolves the
        // standalone compile-check. v1.21.0 carries the canonical window contract
        // (`window_contract.zig` - width/height/frameDuration/requestQuit), the
        // unification target for the beginDrawing->beginFrame / getScreenWidth->
        // width / windowShouldClose->shouldQuit renames in this backend.
        // FLOOR IS v2.1.0: the game-owned shader-material contract
        // (`shader_material.zig`: Descriptor/Parameter/TextureBinding/Id and the
        // validation helpers, `backend_contract.Material.shader`) that
        // `src/gfx/material_store.zig`, `src/gfx/shader_binary.zig` and
        // `texture.drawTextureProMaterial` require, plus `Blend.modulate2x`,
        // which `programs.materialBlendState` switches on. Older cores do not
        // compile. For local integration against a working copy of core, prefer
        // `-Dcore-source=/path/to/labelle-core/src/root.zig`.
        .labelle_core = .{
            .url = "https://github.com/labelle-toolkit/labelle-core/archive/refs/tags/v2.1.0.tar.gz",
            .hash = "labelle_core-2.1.0-OauRcEmpBwB-EUz284qa13cc2A5eu3u1L1avd_FDF0JF",
        },
        // Shared audio engine (pluggable-backends RFC, Phase 2). The bgfx
        // backend's `src/audio.zig` collapses its duplicated WAV decode + PCM
        // mixer onto `labelle_audio.Mixer(Sink)`, keeping only its real OS
        // device code (miniaudio desktop / AAudio Android) adapted to the
        // shared `DeviceSink` contract. In-tree sibling checkout (own-build.zig
        // sub-package), reached via a relative path like the other shared
        // sub-packages above. The generated app build must also wire this dep
        // onto the `audio` module (see CLAUDE notes / report).
        .labelle_audio = .{
            .url = "https://github.com/labelle-toolkit/labelle-audio/archive/refs/tags/v0.2.1.tar.gz",
            .hash = "labelle_audio-0.2.1-QQRmYI4eAQDChv7DVK74-HPS9_J2bJw5ZDKFOazffYjU",
        },
        // Emscripten SDK (bgfx-wasm epic labelle-bgfx#8). Provides `emcc` (the
        // WASM link step in `backend.hook.zig`'s wasm `post_wire`) and the
        // emscripten sysroot headers the stb_image C compile needs (Zig ships no
        // libc headers for wasm32-emscripten). Same pin the sokol + raylib
        // backends use — copied verbatim from labelle-raylib's build.zig.zon so
        // all three web backends resolve one shared emsdk. Only fetched on a wasm
        // build (`b.lazyDependency`); desktop/android never pull it.
        .emsdk = .{
            .url = "git+https://github.com/emscripten-core/emsdk?ref=4.0.9#3bcf1dcd01f040f370e10fe673a092d9ed79ebb5",
            .hash = "N-V-__8AAJl1DwBezhYo_VE6f53mPVm00R-Fk28NPW7P14EQ",
        },
        .labelle_gfx = .{
            .url = "https://github.com/labelle-toolkit/labelle-gfx/archive/refs/tags/v1.29.2.tar.gz",
            .hash = "labelle_gfx-1.29.2-nMpCPKThCQD7Nnc3vCYIAXyFH9CFkH9yWVSaOfDkUciR",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // Assembler-consumed at codegen time (pluggable-backends #386):
        "backend.manifest.zon",
        // Build-graph manifest v2 + its dedicated build hook (epic #453,
        // manifest-v2 Phase A cutover). `generate` auto-detects the v2 manifest and
        // stages the hook it names; both must ship with the package.
        "backend.manifest.v2.zon",
        "backend.hook.zig",
        "build_fragments",
        "templates",
        // Build inputs:
        "src",
        "libs",
        // Standalone wasm/WebGL smoke example built by `zig build wasm-example`
        // (bgfx-wasm #8).
        "example",
    },
}
